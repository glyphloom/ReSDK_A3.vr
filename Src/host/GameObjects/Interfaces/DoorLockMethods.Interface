getter_func(getLockSelection,getSelf(lockSelection));

func(syncDoorLockVisual)
{
	objParams();
	if !callSelf(isInWorld) exitWith {};
	private _mesh = getSelf(loc);
	private _data = [];
	private _lock = getSelf(doorLock);
	if !isNullReference(_lock) then {
		private _selection = callSelf(getLockSelection);
		private _position = getSelf(lockPosition);
		if (count _position == 0) then {
			private _bounds = boundingBoxReal _mesh;
			_position = ((_bounds select 0) vectorAdd (_bounds select 1)) vectorMultiply 0.5;
			if (_selection != "") then {_position = _position vectorDiff (_mesh selectionPosition _selection)};
		};
		_data = [getVar(_lock,pointer),getVar(_lock,model),_position,_selection,getSelf(lockDepth),getSelf(lockDirection),ifcheck(callFunc(_lock,lockGrade) == 0,12,0)];
	};
	_mesh setVariable ["doorLockData",_data];
	private _visuals = [_mesh,_data] call doorLock_updateVisuals;
	{_x setVariable ["link",_lock]} foreach _visuals;
	callSelf(replicateObject);
};

func(installDoorLock)
{
	objParams_2(_lock,_usr);
	callSelf(initializeDoorLock);
	if (!callSelf(hasMechanicalLock) || {!isNullReference(getSelf(doorLock))}) exitWith {};
	if (!equals(callFunc(_usr,getItemInActiveHandRedirect),_lock) || {callFuncParams(_usr,getDistanceTo,this) > 2}) exitWith {};
	if !isNullReference(getVar(_lock,door)) exitWith {};
	callFuncParams(_usr,removeItem,_lock);
	callFuncParams(_lock,setLoc,this);
	setVar(_lock,slot,-1);
	setVar(_lock,door,this);
	setVar(_lock,isFastened,false);
	setSelf(doorLock,_lock);
	setSelf(isLocked,false);
	setSelf(isLockBreaked,false);
	setSelf(keyTypes,getVar(_lock,keyTypes));
	callSelf(syncDoorLockVisual);
};

func(releaseDoorLock)
{
	objParams();
	private _lock = getSelf(doorLock);
	if isNullReference(_lock) exitWith {};
	private _pos = callFunc(_lock,getPos);
	callFunc(_lock,clearToolWork);
	setSelf(doorLock,nullPtr);
	setSelf(isLocked,false);
	setSelf(keyTypes,[]);
	setSelf(isLockBreaked,true);
