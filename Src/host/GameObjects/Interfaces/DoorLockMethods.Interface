};

func(loadModel)
{
	objParams_4(_pos,_dir,_vecOrDist,_simDrop);
	private _result = super();
	if (_result) then {callSelf(syncDoorLockVisual)};
	_result
};

func(destructor)
{
	objParams();
	private _lock = getSelf(doorLock);
	if !isNullReference(_lock) then {
		setVar(_lock,door,nullPtr);
		callFuncParams(_lock,setLoc,nullPtr);
