// Mechanical lock state and its two visual faces are owned by this door slot.
getter_func(hasMechanicalLock,true);
editor_attribute("alias" arg "Тип замка")
editor_attribute("EditorVisible" arg "custom_provider:door_lock")
var(lockType,1);
var(doorLock,nullPtr);
var(lockInitialized,false);
var(lockPosition,[]); // empty: center of the model bounds, relative to the chosen selection
var(lockSelection,"");
var(lockDepth,0.025);
var(lockDirection,0);

func(constructor)
{
	objParams();
	callSelfAfter(initializeDoorLock,0.1);
};

func(initializeDoorLock)
{
	objParams();
	if isNullReference(this) exitWith {};
	if (getSelf(lockInitialized) || {!callSelf(hasMechanicalLock)}) exitWith {};
	if !callSelf(isInWorld) exitWith {};
	setSelf(lockInitialized,true);
	private _type = getSelf(lockType);
	if (_type == 0) exitWith {setSelf(isLocked,false)};
	private _class = ["","DoorLock","StrongDoorLock","StoryDoorLock"] param [_type,"DoorLock"];
	private _lock = instantiate(_class);
	callFuncParams(_lock,setLoc,this);
	setVar(_lock,door,this);
	setVar(_lock,isFastened,true);
	setVar(_lock,keyTypes,getSelf(keyTypes));
	setSelf(doorLock,_lock);
	if getSelf(isLockBreaked) then {
		callSelf(releaseDoorLock);
		delete(_lock);
	} else {
		callSelf(syncDoorLockVisual);
	};
};

func(setDoorKeyTypes)
{
	objParams_1(_types);
	setSelf(keyTypes,_types);
	private _lock = getSelf(doorLock);
	if !isNullReference(_lock) then {setVar(_lock,keyTypes,_types)};
