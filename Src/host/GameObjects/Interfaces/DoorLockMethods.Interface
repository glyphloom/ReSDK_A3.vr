};

func(onDestroyed)
{
	objParams();
	callSelf(releaseDoorLock);
	super();
};

func(unloadModel)
{
	objParams();
	if callSelf(isInWorld) then {[getSelf(loc)] call doorLock_clearVisuals};
	super();
};

// Only fastened working locks protect metal doors.
func(getDoorProtectionGrade)
{
	objParams();
	private _lock = getSelf(doorLock);
	if (isNullReference(_lock) || {!getVar(_lock,isFastened)} || {!isTypeOf(callSelf(getMaterial),MatMetal)}) exitWith {0};
	callFunc(_lock,lockGrade)
};

func(getDamageHPScale)
{
	objParams();
	// GateCity HP from its M2C bounds and MatMetal construction weight.
	if (callSelf(getDoorProtectionGrade) == 2) exitWith {(getSelf(hpMax) / 152) min 1};
	super()
};

// Protection changes the incoming damage, never resets the door's existing HP.
func(applyDamage)
{
	objParams_4(_amount,_type,_worldPos,_cause);
	callSelf(initializeDoorLock);
	private _lock = getSelf(doorLock);
	private _blastAmount = _amount;
	private _grade = callSelf(getDoorProtectionGrade);
	if (_grade == 3) exitWith {};
	if (_grade == 2) then {
		// GateCity DR; HP scaling happens after the base damage-type rounding.
		_amount = ((_amount - (getSelf(dr) max 5)) max 0) + getSelf(dr);
	};
	// Apply the door's old protection before the same blast can destroy the lock.
	private _this = array_copy(_this);
	_this set [1,_amount];
	super();
	if (_type == DAMAGE_TYPE_BLAST && {!isNullReference(_lock)}) then {
		callFuncParams(_lock,applyDamage,_blastAmount arg _type arg _worldPos arg _cause);
	};
};
